<div class="product-detail-container">
    <div class="product-detail">
        <div class="product-images">
            {{#if product.thumbnails.length}}
                {{#each product.thumbnails}}
                <img src="{{this}}" alt="{{../product.title}}" class="product-image">
                {{/each}}
            {{else}}
                <div class="no-image">
                    <p>Sin imagen disponible</p>
                </div>
            {{/if}}
        </div>
        
        <div class="product-info">
            <h1>{{product.title}}</h1>
            <p class="product-code">Código: {{product.code}}</p>
            
            <div class="product-description">
                <h3>Descripción</h3>
                <p>{{product.description}}</p>
            </div>
            
            <div class="product-details">
                <div class="detail-item">
                    <span class="label">Precio:</span>
                    <span class="price">${{product.price}}</span>
                </div>
                
                <div class="detail-item">
                    <span class="label">Categoría:</span>
                    <span>{{product.category}}</span>
                </div>
                
                <div class="detail-item">
                    <span class="label">Stock disponible:</span>
                    <span class="stock">{{product.stock}} unidades</span>
                </div>
                
                <div class="detail-item">
                    <span class="label">Estado:</span>
                    <span class="status {{#unless product.status}}out-of-stock{{/unless}}">
                        {{#if product.status}}Disponible{{else}}No disponible{{/if}}
                    </span>
                </div>
            </div>
            
            {{#if product.status}}
            <div class="purchase-section">
                <div class="quantity-selector">
                    <label for="quantity">Cantidad:</label>
                    <input type="number" id="quantity" value="1" min="1" max="{{product.stock}}">
                </div>
                
                <button onclick="addToCart('{{product._id}}')" class="btn btn-success btn-large">
                    Agregar al carrito
                </button>
            </div>
            {{else}}
            <div class="out-of-stock-message">
                <p>Producto no disponible</p>
            </div>
            {{/if}}
            
            <div class="navigation">
                <a href="/products" class="btn btn-secondary">« Volver al catálogo</a>
            </div>
        </div>
    </div>
</div>

<script>
function addToCart(productId) {
    const quantity = document.getElementById('quantity').value;
    
    // Crear carrito temporal y agregar producto
    fetch('/api/carts', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(cart => {
        // Agregar producto la cantidad de veces especificada
        const promises = [];
        for (let i = 0; i < quantity; i++) {
            promises.push(
                fetch(`/api/carts/${cart._id}/product/${productId}`, {
                    method: 'POST'
                })
            );
        }
        return Promise.all(promises);
    })
    .then(() => {
        alert(`${quantity} producto(s) agregado(s) al carrito!`);
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error al agregar el producto al carrito');
    });
}
</script>

