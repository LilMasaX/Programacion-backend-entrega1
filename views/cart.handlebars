<div class="cart-container">
    <h1>Carrito de Compras</h1>
    
    {{#if products.length}}
    <div class="cart-content">
        <div class="cart-items">
            {{#each products}}
            <div class="cart-item" data-product-id="{{this.product._id}}">
                <div class="item-image">
                    {{#if this.product.thumbnails.length}}
                        <img src="{{this.product.thumbnails.0}}" alt="{{this.product.title}}">
                    {{else}}
                        <div class="no-image">Sin imagen</div>
                    {{/if}}
                </div>
                
                <div class="item-details">
                    <h3>{{this.product.title}}</h3>
                    <p class="item-code">Código: {{this.product.code}}</p>
                    <p class="item-category">{{this.product.category}}</p>
                </div>
                
                <div class="item-price">
                    <span class="unit-price">${{this.product.price}}</span>
                    <span class="price-label">c/u</span>
                </div>
                
                <div class="item-quantity">
                    <button onclick="updateQuantity('{{this.product._id}}', {{this.quantity}} - 1)" class="btn-quantity">-</button>
                    <input type="number" value="{{this.quantity}}" min="1" 
                           onchange="updateQuantity('{{this.product._id}}', this.value)" 
                           class="quantity-input">
                    <button onclick="updateQuantity('{{this.product._id}}', {{this.quantity}} + 1)" class="btn-quantity">+</button>
                </div>
                
                <div class="item-total">
                    ${{multiply this.product.price this.quantity}}
                </div>
                
                <div class="item-actions">
                    <button onclick="removeFromCart('{{this.product._id}}')" class="btn btn-danger">
                        Eliminar
                    </button>
                </div>
            </div>
            {{/each}}
        </div>
        
        <div class="cart-summary">
            <div class="summary-card">
                <h3>Resumen del pedido</h3>
                
                <div class="summary-line">
                    <span>Productos ({{products.length}} artículos):</span>
                    <span>${{total}}</span>
                </div>
                
                <div class="summary-line total-line">
                    <span>Total:</span>
                    <span>${{total}}</span>
                </div>
                
                <button class="btn btn-success btn-large" onclick="proceedToCheckout()">
                    Proceder al pago
                </button>
                
                <button class="btn btn-outline" onclick="clearCart()">
                    Vaciar carrito
                </button>
            </div>
        </div>
    </div>
    {{else}}
    <div class="empty-cart">
        <h2>Tu carrito está vacío</h2>
        <p>¡Agrega algunos productos para comenzar!</p>
        <a href="/products" class="btn btn-primary">Ver productos</a>
    </div>
    {{/if}}
    
    <div class="navigation">
        <a href="/products" class="btn btn-secondary">« Continuar comprando</a>
    </div>
</div>

<script>
const cartId = '{{cartId}}';

function updateQuantity(productId, newQuantity) {
    if (newQuantity < 1) {
        removeFromCart(productId);
        return;
    }
    
    fetch(`/api/carts/${cartId}/products/${productId}`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ quantity: parseInt(newQuantity) })
    })
    .then(response => response.json())
    .then(() => {
        location.reload();
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error al actualizar la cantidad');
    });
}

function removeFromCart(productId) {
    if (confirm('¿Estás seguro de que quieres eliminar este producto del carrito?')) {
        fetch(`/api/carts/${cartId}/products/${productId}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(() => {
            location.reload();
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error al eliminar el producto');
        });
    }
}

function clearCart() {
    if (confirm('¿Estás seguro de que quieres vaciar todo el carrito?')) {
        fetch(`/api/carts/${cartId}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(() => {
            location.reload();
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error al vaciar el carrito');
        });
    }
}

function proceedToCheckout() {
    alert('Funcionalidad de pago en desarrollo');
}
</script>

