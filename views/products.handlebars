<div class="products-container">
    <h1>Catálogo de Productos</h1>
    
    <!-- Filtros -->
    <div class="filters">
        <form method="GET" action="/products">
            <div class="filter-group">
                <label for="category">Categoría:</label>
                <select name="category" id="category">
                    <option value="">Todas las categorías</option>
                    <option value="Tecnología" {{#if (eq query.category "Tecnología")}}selected{{/if}}>Tecnología</option>
                    <option value="Celulares" {{#if (eq query.category "Celulares")}}selected{{/if}}>Celulares</option>
                    <option value="Hogar" {{#if (eq query.category "Hogar")}}selected{{/if}}>Hogar</option>
                    <option value="Deportes" {{#if (eq query.category "Deportes")}}selected{{/if}}>Deportes</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label for="sort">Ordenar por precio:</label>
                <select name="sort" id="sort">
                    <option value="">Sin ordenar</option>
                    <option value="asc" {{#if (eq query.sort "asc")}}selected{{/if}}>Menor a mayor</option>
                    <option value="desc" {{#if (eq query.sort "desc")}}selected{{/if}}>Mayor a menor</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label for="limit">Productos por página:</label>
                <select name="limit" id="limit">
                    <option value="5" {{#if (eq query.limit "5")}}selected{{/if}}>5</option>
                    <option value="10" {{#if (eq query.limit "10")}}selected{{/if}}>10</option>
                    <option value="20" {{#if (eq query.limit "20")}}selected{{/if}}>20</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label for="availability">Disponibilidad:</label>
                <select name="availability" id="availability">
                    <option value="">Todos</option>
                    <option value="true" {{#if (eq query.availability "true")}}selected{{/if}}>Disponible</option>
                    <option value="false" {{#if (eq query.availability "false")}}selected{{/if}}>Agotado</option>
                </select>
            </div>
            
            <button type="submit">Filtrar</button>
        </form>
    </div>

    {{#if payload}}
    <!-- Grid de productos -->
    <div class="products-grid">
        {{#each payload}}
        <div class="product-card">
            <h3>{{this.title}}</h3>
            <p class="description">{{this.description}}</p>
            <p class="price">${{this.price}}</p>
            <p class="category">Categoría: {{this.category}}</p>
            <p class="stock">Stock: {{this.stock}}</p>
            <p class="status {{#unless this.status}}out-of-stock{{/unless}}">
                {{#if this.status}}Disponible{{else}}No disponible{{/if}}
            </p>
            
            <div class="product-actions">
                <a href="/products/{{this._id}}" class="btn btn-primary">Ver detalles</a>
                <button onclick="addToCart('{{this._id}}')" class="btn btn-success">
                    Agregar al carrito
                </button>
            </div>
        </div>
        {{/each}}
    </div>

    <!-- Paginación -->
    <div class="pagination">
        <div class="pagination-info">
            <p>Página {{page}} de {{totalPages}} ({{payload.length}} productos)</p>
        </div>
        
        <div class="pagination-controls">
            {{#if hasPrevPage}}
                <a href="{{prevLink}}" class="btn btn-secondary">« Anterior</a>
            {{/if}}
            
            <span class="current-page">{{page}}</span>
            
            {{#if hasNextPage}}
                <a href="{{nextLink}}" class="btn btn-secondary">Siguiente »</a>
            {{/if}}
        </div>
    </div>
    {{else}}
    <div class="no-products">
        <p>No se encontraron productos</p>
    </div>
    {{/if}}
</div>

<script>
function addToCart(productId) {
    // Por ahora crear un carrito temporal y agregar el producto
    fetch('/api/carts', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(cart => {
        return fetch(`/api/carts/${cart._id}/product/${productId}`, {
            method: 'POST'
        });
    })
    .then(response => response.json())
    .then(result => {
        alert('Producto agregado al carrito!');
        console.log('Producto agregado:', result);
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error al agregar el producto al carrito');
    });
}
</script>

